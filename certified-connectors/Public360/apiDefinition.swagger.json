                    "Title"
                  ],
                  "type": "object",
                  "properties": {
                    "Title": {
                      "title": "Title",
                      "description": "Title for the document.",
                      "type": "string"
                    },
                    "CaseNumber": {
                      "title": "Case Number",
                      "description": "Case Number of the case this document belongs to.",
                      "type": "string",
                      "x-ms-visibility": "important"
                    },
                    "DefaultValueSet": {
                      "title": "Default Value Set",
                      "description": "Set of defined values for Document entities which are used to create document with those values as default if not passed",
                      "type": "string",
                      "x-ms-visibility": "important"
                    },
                    "UnofficialTitle": {
                      "title": "Unofficial title",
                      "description": "Unofficial title for the document.",
                      "x-ms-visibility": "advanced",
                      "type": "string"
                    },
                    "ResponsiblePersonEmail": {
                      "title": "Responsible Person Email",
                      "description": "Responsible person for the document.",
                      "x-ms-visibility": "advanced",
                      "type": "string"
                    },
                    "Category": {
                      "title": "Category",
                      "description": "Category for the document. F.ex., recno:60005 for Internal memo without follow-up",
                      "type": "string",
                      "x-ms-visibility": "advanced",
                      "example": "recno:60005"
                    },
                    "Status": {
                      "title": "Status",
                      "description": "Status for the document.",
                      "x-ms-visibility": "advanced",
                      "enum": [
                        "recno:1",
                        "recno:6"
                      ],
                      "type": "string",
                      "x-ms-enum-values": [
                        {
                          "displayName": "Reserved",
                          "value": "recno:1"
                        },
                        {
                          "displayName": "Officially recorded",
                          "value": "recno:6"
                        }
                      ]
                    },
                    "Archive": {
                      "title": "Archive",
                      "description": "The Document archive for this document",
                      "type": "string",
                      "x-ms-visibility": "advanced"
                    },
                    "Notes": {
                      "title": "Notes",
                      "description": "Notes for the document.",
                      "type": "string",
                      "x-ms-visibility": "advanced"
                    },
                    "Contacts": {
                      "description": "Contacts",
                      "x-ms-visibility": "advanced",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Role": {
                            "title": "Role",
                            "description": "The contact’s role for the specific document. Can be code or recno.",
                            "type": "string"
                          },
                          "ReferenceNumber": {
                            "title": "Reference Number",
                            "description": "Reference Number is the Personal Id Number for a private person and Enterprise Number for an enterprise.",
                            "type": "string"
                          }
                        }
                      }
                    },
                    "AdditionalFields": {
                      "description": "AdditionalFields",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Name": {
                            "title": "Name",
                            "description": "The name of the field. This name is the name in the 360° meta model (Not always the same as seen in 360° GUI.)",
                            "type": "string"
                          },
                          "Value": {
                            "title": "Value",
                            "description": "The string value to be set in the field.",
                            "type": "string"
                          }
                        }
                      },
                      "x-ms-visibility": "advanced"
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful",
            "schema": {
              "type": "object",
              "properties": {
                "Recno": {
                  "format": "int32",
                  "description": "Recno",
                  "type": "integer"
                },
                "DocumentNumber": {
                  "description": "DocumentNumber",
                  "type": "string"
                },
                "Successful": {
                  "description": "Successful",
                  "type": "boolean"
                },
                "ErrorMessage": {
                  "description": "ErrorMessage",
                  "type": "string"
                },
                "ErrorDetails": {
                  "description": "ErrorDetails",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "Bad Gateway"
          }
        },
        "x-codegen-request-body-name": "body"
      }
    },
