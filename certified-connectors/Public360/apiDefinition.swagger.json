{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Public 360",
    "description": "Public 360 is a market leading ECM system in the Nordics. The Public 360 connector enables users to create flows that archive cases, documents and files into Public 360. The Public 360 connector will enable users to archive more and easier! That includes archiving social media posts, Outlook items or OneDrive documents.",
    "contact": {
      "name": "360 support",
      "url": "https://tieto.service-now.com/",
      "email": "360ServiceSupport@tieto.com"
    }
  },
  "host": "paspublicnorlrg.dev.360online.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [

  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/Biz/v2/api/call/SI.Data.RPC/SI.Data.RPC/FileService/CreateFile": {
      "post": {
        "summary": "Create File",
        "description": "This operation is used to create a file in Public 360.",
        "operationId": "CreateFile",
        "consumes": [
          "*/*"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "hosturl",
            "description": "Host URL to point to the public 360 solution.",
            "required": true,
            "type": "string",
            "x-ms-summary": "Host URL"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "required": [
                "parameter"
              ],
              "type": "object",
              "properties": {
                "parameter": {
                  "description": "parameter",
                  "required": [
                    "DocumentNumber",
                    "Format",
                    "Title"
                  ],
                  "type": "object",
                  "properties": {
                    "Title": {
                      "title": "Title",
                      "description": "Title for the file.",
                      "type": "string"
                    },
                    "DocumentNumber": {
                      "title": "Document Number",
                      "description": "Document Number of the document this file belongs to.",
                      "type": "string"
                    },
                    "Format": {
                      "title": "Format",
                      "description": "File type to be passed during the creation of file (e.g. \"txt\" , \"htm\").",
                      "type": "string"
                    },
                    "Data": {
                      "title": "Data (Byte array)",
                      "description": "File contents in the form of byte array.",
                      "type": "string",
                      "x-ms-visibility": "important"
                    },
                    "Base64Data": {
                      "title": "Base64 Data, alternative to byte array. Either Data or Base64Data parameter must be used",
                      "description": "File contents, \"Base64\" encoded.",
                      "type": "string"
                    },
                    "AdditionalFields": {
                      "title": "Additional Fields",
                      "description": "Additional Public 360 fields which are not currently included in the parameters of the action.",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "Name": {
                            "title": "Name",
                            "description": "The name of the field. This name is the name in the 360° meta model (Not always the same as seen in 360° GUI.)",
                            "type": "string"
                          },
                          "Value": {
                            "title": "Value",
                            "description": "The string value to be set in the field.",
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful",
            "schema": {
              "type": "object",
              "properties": {
                "Recno": {
                  "format": "int32",
                  "description": "Recno",
                  "type": "integer"
                },
                "Successful": {
                  "description": "Successful",
                  "type": "boolean"
                },
                "ErrorMessage": {
                  "description": "ErrorMessage",
                  "type": "string"
                },
                "ErrorDetails": {
                  "description": "ErrorDetails",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "502": {
            "description": "Bad Gateway"
          }
        },
        "x-codegen-request-body-name": "body"
      }
    },
    "/Biz/v2/api/call/SI.Data.RPC/SI.Data.RPC/DocumentService/CreateDocument": {
      "post": {
        "summary": "Create Document",
        "description": "This operation is used to create a document in Public 360.",
        "operationId": "CreateDocument",
        "consumes": [
          "*/*"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
